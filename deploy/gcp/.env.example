# Copy to deploy/gcp/.env (gitignored), fill in, then run:  ./deploy/gcp/setup.sh
# Everything the deployment needs lives here. Blank values are allowed where noted.

# --- Target -----------------------------------------------------------------
# vm       one Compute Engine VM running Docker Compose (api, web, worker, mongo, caddy). Cheapest. Default.
# cloudrun three Cloud Run services + MongoDB Atlas. No servers to manage, ~3x the monthly cost.
DEPLOY_TARGET=vm

GCP_PROJECT_ID=cocally-509318
GCP_REGION=australia-southeast1
GCP_ZONE=australia-southeast1-b
GITHUB_REPO=ysgndigitalaisolutions-prog/cocally

# --- VM sizing (vm target) --------------------------------------------------
# e2-standard-2 (2 vCPU / 8 GB, ~USD 55/mo) is enough for ~8 concurrent AI calls.
# e2-standard-4 (4 vCPU / 16 GB, ~USD 110/mo) for ~20.
VM_MACHINE_TYPE=e2-standard-2
VM_DISK_GB=50

# --- Public hostname --------------------------------------------------------
# Leave blank to use <static-ip>.sslip.io (works immediately, real TLS certificate).
# Set a real hostname later and point its A record at the VM's static IP.
DOMAIN=

# --- Database (cloudrun target only; the vm target runs Mongo in Compose) ----
MONGODB_URI=

# --- Telephony ----------------------------------------------------------------
# SIMULATION until the carrier trunk is live, then SIP.
TELEPHONY_DRIVER=SIMULATION
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
HOLD_MUSIC_URL=

# --- AI providers -------------------------------------------------------------
DEEPGRAM_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- ACMA Do Not Call Register (required before any AU campaign dials) ---------
DNCR_ACCOUNT_ID=
DNCR_PASSPHRASE=

# --- Recording (leave blank until a bucket exists) ----------------------------
RECORDING_BUCKET=
RECORDING_S3_REGION=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_ENDPOINT=

# --- First tenant (optional; provisioned on the VM after the first deploy) ----
TENANT_NAME=
TENANT_SLUG=
OWNER_NAME=
OWNER_PHONE=
