# Copy to deploy/gcp/.env (gitignored), fill in, then run:  ./deploy/gcp/setup.sh
# Everything the deployment needs lives here. Blank values are allowed where noted.

# --- Target -----------------------------------------------------------------
# vm       one Compute Engine VM running Docker Compose (api, web, worker, caddy) + MongoDB Atlas. Cheapest. Default.
# cloudrun three Cloud Run services + MongoDB Atlas. No servers to manage, ~3x the monthly cost.
DEPLOY_TARGET=vm

GCP_PROJECT_ID=cocally-509318
GCP_REGION=australia-southeast1
GCP_ZONE=australia-southeast1-b
GITHUB_REPO=ysgndigitalaisolutions-prog/cocally

# --- VM sizing (vm target) --------------------------------------------------
# e2-standard-2 (2 vCPU / 8 GB, ~USD 55/mo) is enough for ~8 concurrent AI calls.
# e2-standard-4 (4 vCPU / 16 GB, ~USD 110/mo) for ~20.
VM_MACHINE_TYPE=e2-standard-2
VM_DISK_GB=50

# --- Public hostname --------------------------------------------------------
# Leave blank to use <static-ip>.sslip.io (works immediately, real TLS certificate).
# Set a real hostname later and point its A record at the VM's static IP.
DOMAIN=

# --- Database: MongoDB Atlas, REQUIRED for both targets ---------------------
# Atlas → Connect → Drivers. Add the database name before the `?`:
#   mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/cocally?retryWrites=true&w=majority
# Atlas Network Access must allow the VM's static IP. setup.sh stops if this is blank.
# QUOTE the value: this file is sourced by the shell and the URI contains '&'.
MONGODB_URI=''

# --- Telephony ----------------------------------------------------------------
# SIMULATION until the carrier trunk is live, then SIP.
TELEPHONY_DRIVER=SIMULATION
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
# Carrier SIP trunk with username/password (digest) auth. Fill these in, then
# `./deploy/gcp/provision-sip-trunk.sh` creates the LiveKit outbound (+ inbound)
# trunk on the VM and prints the id to paste into LIVEKIT_SIP_TRUNK_ID above.
SIP_TRUNK_ADDRESS=            # e.g. sip.carrier.net.au:5060
SIP_TRUNK_USERNAME=
SIP_TRUNK_PASSWORD=
SIP_TRUNK_NUMBERS=            # comma-separated E.164 CLIs, e.g. +61280000001,+61380000001
# Carrier tech prefix prepended to the digits (Telvoq: 45). Blank for Twilio.
SIP_DIAL_PREFIX=
# LiveKit region the calls originate from. IN = India, published static IPs
# 143.223.88.0/21 161.115.160.0/19 153.57.128.0/18 for carriers that allow-list by IP, e.g. Telvoq).
SIP_DESTINATION_COUNTRY=IN
SIP_TRUNK_TRANSPORT=udp       # udp | tcp | tls
HOLD_MUSIC_URL=
BUSINESS_TIMEZONE=Australia/Sydney

# --- Voice pipeline (optional; defaults are the tested pilot setup) -----------
# LLM_MODEL defaults to qwen/qwen3.8-27b (fastest); openai/gpt-oss-120b for quality; TTS_PROVIDER=elevenlabs|cartesia
# needs the matching key below. See agent-worker/README.md, "Latency".
LLM_MODEL=
TTS_PROVIDER=
TTS_VOICE=
NOISE_CANCELLATION=1
WORKER_IDLE_PROCESSES=2
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# --- AI providers -------------------------------------------------------------
# Cerebras: primary on-call LLM when set (Groq becomes the fallback). LLM_PROVIDER=cerebras|groq.
CEREBRAS_API_KEY=
LLM_PROVIDER=
# Gemini in the worker's own region: LLM_PROVIDER=vertex uses the VM's service account
# (needs the Vertex AI API enabled and roles/aiplatform.user); Cerebras/Groq stay as fallback.
# LLM_PROVIDER=gemini uses GOOGLE_API_KEY instead. GEMINI_MODEL defaults to gemini-2.5-flash-lite.
GEMINI_MODEL=
GOOGLE_API_KEY=
# VERTEX_LOCATION defaults to GCP_REGION.
VERTEX_LOCATION=
DEEPGRAM_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- ACMA Do Not Call Register (required before any AU campaign dials) ---------
# DNCR_BYPASS=true skips the wash check (internal testing only; remove before dialling AU customers).
DNCR_BYPASS=
DNCR_ACCOUNT_ID=
DNCR_PASSPHRASE=

# --- Recording (leave blank until a bucket exists) ----------------------------
RECORDING_BUCKET=
RECORDING_S3_REGION=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_ENDPOINT=
# Base64 of the cocally-recordings service-account JSON key. When set, recordings
# upload natively to GCS (the S3 interop route fails: SignatureDoesNotMatch).
RECORDING_GCP_CREDENTIALS=

# --- First tenant (optional; provisioned on the VM after the first deploy) ----
TENANT_NAME=
TENANT_SLUG=
OWNER_NAME=
OWNER_PHONE=
