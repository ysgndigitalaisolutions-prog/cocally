# Copy to /opt/cocally/.env.prod on the VM. Never commit the real file.
# Generate secrets with:  openssl rand -hex 32

# --- Host ---
DOMAIN=app.example.com
IMAGE_REGISTRY=ghcr.io/ysgndigitalaisolutions-prog
IMAGE_TAG=latest

# --- API (required in production; the API refuses to boot with dev defaults) ---
JWT_SECRET=
VAULT_KEY=
ENGINE_SERVICE_TOKEN=
# Leave MONGODB_URI unset to use the bundled Mongo container; set it for Atlas.
# MONGODB_URI=mongodb+srv://...

# --- Telephony (SIMULATION until the carrier trunk is live) ---
TELEPHONY_DRIVER=SIMULATION
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_SIP_TRUNK_ID=
HOLD_MUSIC_URL=

# --- AI providers ---
DEEPGRAM_API_KEY=
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Recording (blank = off; only "true" turns it on) ---
RECORDING_ENABLED=
RECORDING_BUCKET=
RECORDING_S3_REGION=
RECORDING_S3_ACCESS_KEY=
RECORDING_S3_SECRET=
RECORDING_S3_ENDPOINT=

# --- ACMA Do Not Call Register (required for any AU campaign) ---
DNCR_ENABLED=
DNCR_ACCOUNT_ID=
DNCR_PASSPHRASE=
