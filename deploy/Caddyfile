# Single public host. Caddy terminates TLS (Let's Encrypt) and routes:
#   /api/*        -> NestJS API
#   /socket.io/*  -> NestJS Socket.IO (workspace realtime, namespace /ws)
#   everything    -> Next.js
{$DOMAIN} {
	encode zstd gzip

	@api path /api/* /socket.io/*
	handle @api {
		reverse_proxy api:4000
	}

	handle {
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format json
	}
}
