# LiveKit Cloud project — Settings -> Keys in the LiveKit Cloud dashboard.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech + language. Deepgram does BOTH STT and Aura TTS; Groq runs the LLM.
DEEPGRAM_API_KEY=
CEREBRAS_API_KEY=            # primary on-call LLM when set; Groq becomes the fallback
GROQ_API_KEY=

# CoCally engine (only used on real calls, to fetch the per-call brief).
ENGINE_BASE_URL=http://localhost:4000/api/v1
ENGINE_SERVICE_TOKEN=

# --- Latency / voice stack knobs (all optional) ---------------------------------
# LLM on Groq: qwen/qwen3.8-27b (default, fastest, ~190 ms first token) | openai/gpt-oss-120b (higher quality, slower)
# (Groq retired the Llama 3.x models in 2026.)
LLM_MODEL=qwen/qwen3.8-27b
# LLM_PROVIDER=cerebras|groq|vertex|gemini. vertex/gemini use GEMINI_MODEL (default gemini-3.5-flash-lite).
# vertex: GOOGLE_CLOUD_PROJECT + GOOGLE_CLOUD_LOCATION and Google application-default credentials.
GEMINI_MODEL=
LLM_MAX_TOKENS=160
# STT + turn-taking: flux (default; Deepgram Flux decides end-of-turn itself, ~260 ms, with eager
# end-of-turn so the LLM starts early) | nova (nova-2-phonecall + local end-of-turn model, the older stack).
STT_MODEL=flux
# Turn/interruption driver with Flux: vad (default, local VAD; stable on echoey lines) | stt (Flux StartOfTurn/EndOfTurn + eager end-of-turn; faster, paused replies seen on 28 Sep).
STT_TURN=vad
# Words the STT should favour, comma-separated (retailer/brand names the campaign mentions).
STT_KEYTERMS=
# TTS: deepgram (default, aura-2) | elevenlabs (eleven_flash_v2_5, ~75 ms TTFB, needs ELEVENLABS_API_KEY)
#      | cartesia (sonic-2, needs CARTESIA_API_KEY). TTS_VOICE overrides the voice/model id.
TTS_PROVIDER=deepgram
TTS_VOICE=
# LiveKit Cloud background-voice cancellation tuned for PSTN audio (1/0).
NOISE_CANCELLATION=1
# Warm worker processes with models already loaded (bursts of answered calls).
WORKER_IDLE_PROCESSES=2
