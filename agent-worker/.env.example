# LiveKit Cloud project — Settings -> Keys in the LiveKit Cloud dashboard.
LIVEKIT_URL=wss://YOUR-PROJECT.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Speech + language. Deepgram does BOTH STT and Aura TTS; Groq runs the LLM.
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# CoCally engine (only used on real calls, to fetch the per-call brief).
ENGINE_BASE_URL=http://localhost:4000/api/v1
ENGINE_SERVICE_TOKEN=

# --- Latency / voice stack knobs (all optional) ---------------------------------
# LLM on Groq: qwen/qwen3.8-27b (default, fastest, ~190 ms first token) | openai/gpt-oss-120b (higher quality, slower)
# (Groq retired the Llama 3.x models in 2026.)
LLM_MODEL=qwen/qwen3.8-27b
LLM_MAX_TOKENS=160
# TTS: deepgram (default, aura-2) | elevenlabs (eleven_flash_v2_5, ~75 ms TTFB, needs ELEVENLABS_API_KEY)
#      | cartesia (sonic-2, needs CARTESIA_API_KEY). TTS_VOICE overrides the voice/model id.
TTS_PROVIDER=deepgram
TTS_VOICE=
# LiveKit Cloud background-voice cancellation tuned for PSTN audio (1/0).
NOISE_CANCELLATION=1
# Warm worker processes with models already loaded (bursts of answered calls).
WORKER_IDLE_PROCESSES=2
